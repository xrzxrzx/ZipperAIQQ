<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>ZipperAIQQ.Server</RootNamespace>
  </PropertyGroup>

  <!-- 组合根：Server 依赖所有模块，反向不成立 -->
  <ItemGroup>
    <ProjectReference Include="..\ZipperAIQQ.Agent\ZipperAIQQ.Agent.csproj" />
    <ProjectReference Include="..\ZipperAIQQ.Channel\ZipperAIQQ.Channel.csproj" />
    <ProjectReference Include="..\ZipperAIQQ.Core\ZipperAIQQ.Core.csproj" />
    <ProjectReference Include="..\ZipperAIQQ.Storage\ZipperAIQQ.Storage.csproj" />
    <ProjectReference Include="..\ZipperAIQQ.Transport\ZipperAIQQ.Transport.csproj" />
  </ItemGroup>

  <!-- M2-A：HTTP 命令 + WS 事件端点（Kestrel）。
       只引框架、不切 Web SDK —— 避免 Web SDK 的隐式日志/配置行为与 Serilog 打架。 -->
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>
  <ItemGroup>
    <!-- Microsoft.Extensions.Hosting 由 FrameworkReference（Microsoft.AspNetCore.App）提供，
         显式再引会被 NU1510 判为多余 -->
    <PackageReference Include="OpenTelemetry.Exporter.Console" Version="1.20.1" />
    <PackageReference Include="OpenTelemetry.Extensions.Hosting" Version="1.20.1" />
    <PackageReference Include="OpenTelemetry.Instrumentation.Http" Version="1.20.0" />
    <PackageReference Include="Serilog.Extensions.Hosting" Version="10.0.0" />
    <PackageReference Include="Serilog.Sinks.Console" Version="6.1.1" />
    <PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
  </ItemGroup>

  <!-- 图片渲染（/status 的表格图）：SkiaSharp 跨平台，服务端在 Linux 也能构建 -->
  <ItemGroup>
    <PackageReference Include="SkiaSharp" Version="3.119.0" />
    <PackageReference Include="SkiaSharp.NativeAssets.Linux" Version="3.119.0" />
  </ItemGroup>

</Project>