<Page
    x:Class="ZipperAIQQ.Client.Views.SessionsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:dto="using:ZipperAIQQ.Client.Dto"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="mc">

    <Grid Padding="32" ColumnSpacing="20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="320" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- 左：会话列表 -->
        <StackPanel Spacing="12">
            <TextBlock Text="会话" Style="{StaticResource PageTitleStyle}" />

            <!-- 搜索（#30）：回车 / 点放大镜触发，匹配显示名与会话 ID -->
            <AutoSuggestBox PlaceholderText="搜昵称或会话 ID…"
                            QueryIcon="Find"
                            Text="{x:Bind Vm.SearchText, Mode=TwoWay}"
                            QuerySubmitted="SearchBox_QuerySubmitted" />

            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Content="刷新会话" Style="{StaticResource JpButtonStyle}"
                        Command="{x:Bind Vm.LoadSessionsCommand}" />
                <Button Content="清空搜索" Style="{StaticResource JpButtonStyle}"
                        Command="{x:Bind Vm.ClearSearchCommand}" />
            </StackPanel>

            <Border Style="{StaticResource CardStyle}" Padding="8">
                <ListView ItemsSource="{x:Bind Vm.Sessions}"
                          SelectedItem="{x:Bind Vm.SelectedSession, Mode=TwoWay}"
                          SelectionMode="Single">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="dto:SessionDto">
                            <StackPanel Padding="4,6">
                                <TextBlock Text="{x:Bind Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{x:Bind LastMessageText}" Style="{StaticResource CaptionStyle}" />
                            </StackPanel>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Border>
        </StackPanel>

        <!-- 右：消息 -->
        <Grid Grid.Column="1" RowSpacing="12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <TextBlock Text="消息" Style="{StaticResource PageTitleStyle}" />

            <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8">
                <Button Content="加载消息" Style="{StaticResource JpAccentButtonStyle}"
                        Command="{x:Bind Vm.LoadMessagesCommand}" />
                <Button Content="按区间导出…" Style="{StaticResource JpButtonStyle}"
                        Click="ExportRange_Click" />
                <TextBlock Text="{x:Bind Vm.SessionStatus, Mode=OneWay}"
                           VerticalAlignment="Center" Style="{StaticResource CaptionStyle}" />
            </StackPanel>

            <Border Grid.Row="2" Style="{StaticResource CardStyle}" Padding="8">
                <ListView x:Name="MessageList"
                          ItemsSource="{x:Bind Vm.Messages}"
                          SelectionMode="None">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="dto:MessageDto">
                            <!-- 分段显示（#3）：时间灰 / AI 樱粉 + 左侧色条 / 用户淡紫 / 正文主色 -->
                            <Grid ColumnSpacing="8" Padding="4,3">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="3" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <Border x:Name="AiBar"
                                        x:Load="{x:Bind IsOutgoing}"
                                        Grid.Column="0"
                                        Background="{ThemeResource JpAccentBrush}"
                                        CornerRadius="2" />

                                <TextBlock Grid.Column="1"
                                           Text="{x:Bind TimeText}"
                                           Foreground="#8A7A85"
                                           FontSize="12"
                                           VerticalAlignment="Top" />

                                <TextBlock x:Name="AiSender"
                                           x:Load="{x:Bind IsOutgoing}"
                                           Grid.Column="2"
                                           Text="{x:Bind SenderText}"
                                           Foreground="{ThemeResource JpAccentBrush}"
                                           FontWeight="SemiBold"
                                           VerticalAlignment="Top" />

                                <TextBlock x:Name="UserSender"
                                           x:Load="{x:Bind IsUser}"
                                           Grid.Column="2"
                                           Text="{x:Bind SenderText}"
                                           Foreground="#B9A7FF"
                                           FontWeight="SemiBold"
                                           VerticalAlignment="Top" />

                                <TextBlock Grid.Column="3"
                                           Text="{x:Bind BodyText}"
                                           TextWrapping="Wrap"
                                           IsTextSelectionEnabled="True" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Border>
        </Grid>
    </Grid>
</Page>
