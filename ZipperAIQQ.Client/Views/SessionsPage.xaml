<Page
    x:Class="ZipperAIQQ.Client.Views.SessionsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:dto="using:ZipperAIQQ.Client.Dto"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="mc">

    <Grid Padding="32" ColumnSpacing="20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="300" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- 左：会话列表 -->
        <StackPanel Spacing="12">
            <TextBlock Text="会话" Style="{StaticResource PageTitleStyle}" />
            <Button Content="刷新会话" Style="{StaticResource JpButtonStyle}" Command="{x:Bind Vm.LoadSessionsCommand}" HorizontalAlignment="Left" />
            <Border Style="{StaticResource CardStyle}" Padding="8">
                <ListView ItemsSource="{x:Bind Vm.Sessions}"
                          SelectedItem="{x:Bind Vm.SelectedSession, Mode=TwoWay}"
                          SelectionMode="Single">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="dto:SessionDto">
                            <StackPanel Padding="4,6">
                                <TextBlock Text="{x:Bind SessionId}" FontWeight="SemiBold" />
                                <TextBlock Text="{x:Bind LastMessageText}" Style="{StaticResource CaptionStyle}" />
                            </StackPanel>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Border>
        </StackPanel>

        <!-- 右：消息 -->
        <Grid Grid.Column="1" RowSpacing="12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <TextBlock Text="消息" Style="{StaticResource PageTitleStyle}" />

            <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8">
                <Button Content="加载消息" Style="{StaticResource JpAccentButtonStyle}"
                        Command="{x:Bind Vm.LoadMessagesCommand}" />
                <Button Content="导出到文件" Style="{StaticResource JpButtonStyle}" Command="{x:Bind Vm.ExportCommand}" />
                <TextBlock Text="{x:Bind Vm.SessionStatus, Mode=OneWay}"
                           VerticalAlignment="Center" Style="{StaticResource CaptionStyle}" />
            </StackPanel>

            <Border Grid.Row="2" Style="{StaticResource CardStyle}" Padding="8">
                <ListView x:Name="MessageList"
                          ItemsSource="{x:Bind Vm.Messages}"
                          SelectionMode="None">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="dto:MessageDto">
                            <TextBlock Text="{x:Bind Display}"
                                       TextWrapping="Wrap"
                                       Padding="4,3"
                                       IsTextSelectionEnabled="True" />
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Border>
        </Grid>
    </Grid>
</Page>
