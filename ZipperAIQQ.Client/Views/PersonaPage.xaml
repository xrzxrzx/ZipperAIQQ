<Page
    x:Class="ZipperAIQQ.Client.Views.PersonaPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:ZipperAIQQ.Client.Controls"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="mc">

    <ScrollViewer Padding="32">
        <StackPanel Spacing="16" MaxWidth="1200" HorizontalAlignment="Left">

            <TextBlock Text="人设" Style="{StaticResource PageTitleStyle}" />
            <TextBlock Text="选一个会话编辑它的人设；全局人设始终生效"
                       Style="{StaticResource CaptionStyle}" Margin="0,-8,0,4" />

            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="12">

                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0" Text="会话" VerticalAlignment="Center" />
                        <controls:FilterableComboBox Grid.Column="1"
                                                     ItemsSource="{x:Bind Vm.SessionOptions}"
                                                     SelectedItem="{x:Bind Vm.SelectedSession, Mode=TwoWay}"
                                                     PlaceholderText="搜会话昵称…" />
                        <Button Grid.Column="2" Content="切回全局"
                                Style="{StaticResource JpButtonStyle}"
                                Command="{x:Bind Vm.BackToGlobalCommand}" />
                    </Grid>

                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <ToggleSwitch Header="当前会话启用角色预设"
                                      IsOn="{x:Bind Vm.Enabled, Mode=TwoWay}"
                                      IsEnabled="{x:Bind Vm.CanToggle, Mode=OneWay}" />
                        <TextBlock Text="全局人设不可关闭；关掉会话预设就回落到全局"
                                   Style="{StaticResource CaptionStyle}" VerticalAlignment="Bottom"
                                   TextWrapping="Wrap" />
                    </StackPanel>

                    <TextBox Header="形象（外观 / 身份 / 说话风格）"
                             Text="{x:Bind Vm.PersonaImage, Mode=TwoWay}"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             MinHeight="120" />

                    <TextBox Header="性格（习惯 / 情绪反应）"
                             Text="{x:Bind Vm.PersonaPersonality, Mode=TwoWay}"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             MinHeight="120" />

                    <TextBlock Text="{x:Bind Vm.Hint, Mode=OneWay}"
                               Style="{StaticResource CaptionStyle}" TextWrapping="Wrap" />

                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <Button Content="保存人设" Style="{StaticResource JpAccentButtonStyle}"
                                Command="{x:Bind Vm.SaveCommand}" />
                        <Button Content="清除会话预设" Style="{StaticResource JpButtonStyle}"
                                Command="{x:Bind Vm.ClearCommand}" />
                        <TextBlock Text="{x:Bind Vm.Status, Mode=OneWay}"
                                   Style="{StaticResource CaptionStyle}" VerticalAlignment="Center"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
