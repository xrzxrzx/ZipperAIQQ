<Page
    x:Class="ZipperAIQQ.Client.Views.ToolsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:ZipperAIQQ.Client.ViewModels"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="mc">

    <Page.Resources>
        <DataTemplate x:Key="PolicyRowTemplate" x:DataType="vm:ToolPolicyRow">
            <Grid ColumnSpacing="12" Padding="0,5">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="220" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="150" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="{x:Bind Label}" FontWeight="SemiBold" TextWrapping="Wrap" />
                    <TextBlock Text="{x:Bind Key}" Style="{StaticResource CaptionStyle}" FontSize="11" />
                </StackPanel>

                <ToggleSwitch Grid.Column="1" IsOn="{x:Bind Enabled, Mode=TwoWay}" />

                <ComboBox Grid.Column="2"
                          ItemsSource="{x:Bind vm:ToolsViewModel.Roles}"
                          SelectedItem="{x:Bind Role, Mode=TwoWay}" />

                <TextBlock Grid.Column="3" Text="{x:Bind Subtitle}"
                           Style="{StaticResource CaptionStyle}" VerticalAlignment="Center"
                           TextWrapping="Wrap" />
            </Grid>
        </DataTemplate>
    </Page.Resources>

    <ScrollViewer Padding="32">
        <StackPanel Spacing="16" MaxWidth="1100" HorizontalAlignment="Center">

            <TextBlock Text="工具管理" Style="{StaticResource PageTitleStyle}" />
            <TextBlock Text="工具 / 命令 / NapCat API 的开关与最低角色；保存后立即生效"
                       Style="{StaticResource CaptionStyle}" Margin="0,-8,0,4" />

            <StackPanel Orientation="Horizontal" Spacing="10">
                <TextBox PlaceholderText="搜索名称或键名…" MinWidth="280"
                         Text="{x:Bind Vm.SearchText, Mode=TwoWay}" />
                <Button Content="保存全部" Style="{StaticResource JpAccentButtonStyle}"
                        Command="{x:Bind Vm.SaveCommand}" />
                <Button Content="重新加载" Style="{StaticResource JpButtonStyle}"
                        Command="{x:Bind Vm.LoadCommand}" />
                <TextBlock Text="{x:Bind Vm.Status, Mode=OneWay}"
                           Style="{StaticResource CaptionStyle}" VerticalAlignment="Center"
                           TextWrapping="Wrap" />
            </StackPanel>

            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="8">
                    <TextBlock Text="工具" Style="{StaticResource SectionHeaderStyle}" />
                    <ItemsControl ItemsSource="{x:Bind Vm.Tools}" ItemTemplate="{StaticResource PolicyRowTemplate}" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="8">
                    <TextBlock Text="命令" Style="{StaticResource SectionHeaderStyle}" />
                    <TextBlock Text="命令权限：Normal = 所有人；Admin = 管理员；Owner = 仅主人"
                               Style="{StaticResource CaptionStyle}" TextWrapping="Wrap" />
                    <ItemsControl ItemsSource="{x:Bind Vm.Commands}" ItemTemplate="{StaticResource PolicyRowTemplate}" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="8">
                    <TextBlock Text="NapCat API" Style="{StaticResource SectionHeaderStyle}" />
                    <TextBlock Text="只读 API 默认所有人可用；写操作默认仅管理员。这里只能收紧，不能放开白名单。"
                               Style="{StaticResource CaptionStyle}" TextWrapping="Wrap" />
                    <ItemsControl ItemsSource="{x:Bind Vm.ChannelApis}" ItemTemplate="{StaticResource PolicyRowTemplate}" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
