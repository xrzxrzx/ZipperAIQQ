<Page
    x:Class="ZipperAIQQ.Client.Views.RuntimePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:ZipperAIQQ.Client.ViewModels"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="mc">

    <ScrollViewer Padding="32">
        <StackPanel Spacing="16" HorizontalAlignment="Stretch">

            <TextBlock Text="运行与行为" Style="{StaticResource PageTitleStyle}" />
            <TextBlock Text="数值型运行参数 / 回复模式 / 通知响应"
                       Style="{StaticResource CaptionStyle}" Margin="0,-8,0,4" />

            <!-- 运行参数 -->
            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="10">
                    <TextBlock Text="运行参数" Style="{StaticResource SectionHeaderStyle}" />

                    <ItemsControl ItemsSource="{x:Bind Vm.Settings}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:SettingItem">
                                <Grid ColumnSpacing="12" Padding="0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="220" />
                                        <ColumnDefinition Width="160" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{x:Bind Label}"
                                               VerticalAlignment="Center" TextWrapping="Wrap" />
                                    <NumberBox Grid.Column="1"
                                               Value="{x:Bind Value, Mode=TwoWay}"
                                               Minimum="{x:Bind Min}"
                                               Maximum="{x:Bind Max}"
                                               SpinButtonPlacementMode="Compact" />
                                    <TextBlock Grid.Column="2" Text="{x:Bind Hint}"
                                               Style="{StaticResource CaptionStyle}" VerticalAlignment="Center"
                                               TextWrapping="Wrap" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Text="JEV 判断灵敏度" FontWeight="SemiBold" Margin="0,6,0,0" />
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="140" />
                        </Grid.ColumnDefinitions>
                        <Slider Grid.Column="0" Minimum="0.05" Maximum="0.95" StepFrequency="0.05"
                                Value="{x:Bind Vm.JudgeThreshold, Mode=TwoWay}" />
                        <NumberBox Grid.Column="1" Minimum="0.05" Maximum="0.95" SmallChange="0.05"
                                   Value="{x:Bind Vm.JudgeThreshold, Mode=TwoWay}" />
                    </Grid>
                    <TextBlock Text="调低 = 更爱插话；调高 = 更少出声"
                               Style="{StaticResource CaptionStyle}" TextWrapping="Wrap" />

                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <Button Content="保存运行参数" Style="{StaticResource JpAccentButtonStyle}"
                                Command="{x:Bind Vm.SaveSettingsCommand}" />
                        <TextBlock Text="{x:Bind Vm.SettingsStatus, Mode=OneWay}"
                                   Style="{StaticResource CaptionStyle}" VerticalAlignment="Center" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- 行为设置 -->
            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="10">
                    <TextBlock Text="行为设置" Style="{StaticResource SectionHeaderStyle}" />

                    <TextBlock Text="回复模式" FontWeight="SemiBold" />
                    <ComboBox MinWidth="240"
                              ItemsSource="{x:Bind Vm.ReplyModes}"
                              SelectedItem="{x:Bind Vm.ReplyMode, Mode=TwoWay}" />
                    <TextBlock Text="every = 每条都回；mention = 只有 @ 才回；jev = 交给判断模型决定"
                               Style="{StaticResource CaptionStyle}" TextWrapping="Wrap" />

                    <TextBlock Text="通知响应" FontWeight="SemiBold" Margin="0,8,0,0" />
                    <TextBox PlaceholderText="搜索通知类型…" MinWidth="260" HorizontalAlignment="Left"
                             Text="{x:Bind Vm.NoticeSearch, Mode=TwoWay}" />

                    <!-- 常用 / 其他 左右并列 -->
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Spacing="6">
                            <TextBlock Text="常用" Style="{StaticResource CaptionStyle}" />
                            <ScrollViewer MaxHeight="320" VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{x:Bind Vm.CommonNotices}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:NoticeToggleItem">
                                            <Grid ColumnSpacing="12" Padding="0,3">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="{x:Bind Label}"
                                                           VerticalAlignment="Center" TextWrapping="Wrap" />
                                                <ToggleSwitch Grid.Column="1" IsOn="{x:Bind Enabled, Mode=TwoWay}" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Spacing="6">
                            <TextBlock Text="其他" Style="{StaticResource CaptionStyle}" />
                            <ScrollViewer MaxHeight="320" VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{x:Bind Vm.OtherNotices}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:NoticeToggleItem">
                                            <Grid ColumnSpacing="12" Padding="0,3">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="{x:Bind Label}"
                                                           VerticalAlignment="Center" TextWrapping="Wrap" />
                                                <ToggleSwitch Grid.Column="1" IsOn="{x:Bind Enabled, Mode=TwoWay}" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </StackPanel>
                    </Grid>

                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <Button Content="保存行为设置" Style="{StaticResource JpAccentButtonStyle}"
                                Command="{x:Bind Vm.SaveBehaviorCommand}" />
                        <TextBlock Text="{x:Bind Vm.BehaviorStatus, Mode=OneWay}"
                                   Style="{StaticResource CaptionStyle}" VerticalAlignment="Center" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- 系统提示词：与人设分开 -->
            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="10">
                    <TextBlock Text="系统提示词" Style="{StaticResource SectionHeaderStyle}" />
                    <TextBlock Text="决定「怎么做事」：工具怎么用、语气口吻、哪些事可以主动做。与人设分开保存；留空/重置即恢复默认。"
                               Style="{StaticResource CaptionStyle}" TextWrapping="Wrap" />

                    <TextBox Text="{x:Bind Vm.SystemPrompt, Mode=TwoWay}"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             MinHeight="300"
                             FontFamily="Consolas"
                             FontSize="12" />

                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <Button Content="保存系统提示词" Style="{StaticResource JpAccentButtonStyle}"
                                Command="{x:Bind Vm.SavePromptCommand}" />
                        <Button Content="恢复默认" Style="{StaticResource JpButtonStyle}"
                                Command="{x:Bind Vm.ResetPromptCommand}" />
                        <TextBlock Text="{x:Bind Vm.PromptStatus, Mode=OneWay}"
                                   Style="{StaticResource CaptionStyle}" VerticalAlignment="Center"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
