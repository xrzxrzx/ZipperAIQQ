<Page
    x:Class="ZipperAIQQ.Client.Views.PlatformsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:ZipperAIQQ.Client.ViewModels"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="mc">

    <Page.Resources>
        <!-- 顶部接入状态的一块（邮件 / 抖音）：绿点/灰点用 x:Load 二选一，VM 不碰 Brush -->
        <DataTemplate x:Key="OverviewChip" x:DataType="vm:OverviewChipItem">
            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                <Grid Width="10" Height="10" VerticalAlignment="Center">
                    <Ellipse x:Name="ChipConnectedDot" Fill="#FF6BD08A" x:Load="{x:Bind Connected}" />
                    <Ellipse x:Name="ChipOfflineDot" Fill="#667A6B72" x:Load="{x:Bind Offline}" />
                </Grid>
                <TextBlock Text="{x:Bind Label}" FontWeight="SemiBold" VerticalAlignment="Center" />
                <TextBlock Text="{x:Bind StatusText}" Style="{StaticResource CaptionStyle}"
                           VerticalAlignment="Center" />
                <!-- 出问题时补一段红字（账号 lastError 之类），没问题就整块不生成 -->
                <TextBlock x:Name="ChipError" Text="{x:Bind ErrorText}" Foreground="OrangeRed" FontSize="12"
                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="320"
                           x:Load="{x:Bind HasError}" />
            </StackPanel>
        </DataTemplate>

        <!-- 邮件页的一张账号卡（照 ExternalPage 的数据块：标题 + ToggleSwitch + 信息块 + 操作按钮） -->
        <DataTemplate x:Key="MailAccountCard" x:DataType="vm:MailAccountItem">
            <Border Style="{StaticResource CardStyle}" Width="360" Padding="14" Margin="0,0,12,12">
                <StackPanel Spacing="8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Spacing="2">
                            <TextBlock Text="{x:Bind Address}" FontWeight="SemiBold"
                                       TextTrimming="CharacterEllipsis" />
                            <!-- 没填显示名就整行不生成（以前会显示「未命名账号」，看着像漏写） -->
                            <TextBlock x:Name="MailSubtitle" Text="{x:Bind SubtitleText, Mode=OneWay}"
                                       Style="{StaticResource CaptionStyle}"
                                       TextTrimming="CharacterEllipsis"
                                       x:Load="{x:Bind HasDisplayName, Mode=OneWay}" />
                        </StackPanel>
                        <ToggleSwitch Grid.Column="1" VerticalAlignment="Top"
                                      IsOn="{x:Bind Enabled, Mode=OneWay}"
                                      Toggled="MailEnabled_Toggled" />
                    </Grid>

                    <Border Background="#1AFFFFFF" CornerRadius="6" Padding="10,8">
                        <StackPanel Spacing="4">
                            <TextBlock Text="{x:Bind ImapText}" TextWrapping="Wrap" />
                            <TextBlock Text="{x:Bind SecretText}" Style="{StaticResource CaptionStyle}"
                                       TextWrapping="Wrap" />
                            <TextBlock Text="{x:Bind SyncText}" Style="{StaticResource CaptionStyle}"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                    <TextBlock x:Name="LastErrorLine" Text="{x:Bind ErrorText}" Foreground="OrangeRed"
                               FontSize="12" TextWrapping="Wrap" x:Load="{x:Bind HasError}" />

                    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                        <Button Content="编辑" Style="{StaticResource JpButtonStyle}" Click="EditMail_Click" />
                        <Button Content="删除" Style="{StaticResource JpButtonStyle}" Click="RemoveMail_Click" />
                        <Button Content="立即同步" Style="{StaticResource JpButtonStyle}" Click="SyncMail_Click" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </DataTemplate>
    </Page.Resources>

    <ScrollViewer Padding="32">
        <StackPanel Spacing="16" HorizontalAlignment="Stretch">

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Spacing="4">
                    <TextBlock Text="第三方平台接入" Style="{StaticResource PageTitleStyle}" />
                    <TextBlock Text="邮件 / 抖音 —— 各自配置、各自保存；凭据只显示「已配置」，永不回显"
                               Style="{StaticResource CaptionStyle}" TextWrapping="Wrap" />
                </StackPanel>
                <Button Grid.Column="1" Content="刷新" Style="{StaticResource JpButtonStyle}"
                        VerticalAlignment="Bottom" Command="{x:Bind Vm.LoadCommand}" />
            </Grid>

            <!-- 接入状态（只看邮件 / 抖音；QQ 归状态页，不在这排） -->
            <Border Style="{StaticResource CardStyle}" Padding="14">
                <StackPanel Spacing="6">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <TextBlock Text="通道" Style="{StaticResource SectionHeaderStyle}" Margin="0"
                                   VerticalAlignment="Center" />
                        <ItemsControl ItemsSource="{x:Bind Vm.OverviewChips}"
                                      ItemTemplate="{StaticResource OverviewChip}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" Spacing="16" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                    </StackPanel>
                    <TextBlock Text="{x:Bind Vm.OverviewStatus, Mode=OneWay}"
                               Style="{StaticResource CaptionStyle}" TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <Pivot Margin="0,4,0,0">
                <!-- ── 邮件 ─────────────────────────────────────────── -->
                <PivotItem Header="邮件">
                    <StackPanel Spacing="12" Margin="0,8,0,0">

                        <!-- 通道开关（S3-F 补）：两个都是运行时热切，改完不必重启服务 -->
                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel Spacing="12">
                                <StackPanel Spacing="8">
                                    <ToggleSwitch Header="启用邮件接入"
                                                  IsOn="{x:Bind Vm.MailEnabled, Mode=OneWay}"
                                                  IsEnabled="{x:Bind Vm.MailSwitchAvailable, Mode=OneWay}"
                                                  Toggled="MailChannel_Toggled" />
                                    <TextBlock Text="{x:Bind Vm.MailChannelText, Mode=OneWay}"
                                               Style="{StaticResource CaptionStyle}" TextWrapping="Wrap" />
                                    <TextBlock Text="{x:Bind Vm.MailSwitchStatus, Mode=OneWay}"
                                               Style="{StaticResource CaptionStyle}" TextWrapping="Wrap" />
                                    <TextBlock Text="关闭后不再连 IMAP 收信；已收的邮件与账号仍保留。"
                                               Style="{StaticResource CaptionStyle}" TextWrapping="Wrap" />
                                </StackPanel>

                                <StackPanel Spacing="8">
                                    <ToggleSwitch Header="汇总再经人格润色"
                                                  IsOn="{x:Bind Vm.MailPersonaDigest, Mode=OneWay}"
                                                  IsEnabled="{x:Bind Vm.MailSwitchAvailable, Mode=OneWay}"
                                                  Toggled="MailPersonaDigest_Toggled" />
                                    <TextBlock Text="{x:Bind Vm.MailPersonaDigestStatus, Mode=OneWay}"
                                               Style="{StaticResource CaptionStyle}" TextWrapping="Wrap" />
                                    <TextBlock Text="开启：先交你的人设 agent 用她的语气转告；关闭：直接发汇总文本（省一次模型调用）。"
                                               Style="{StaticResource CaptionStyle}" TextWrapping="Wrap" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="收信账号" Style="{StaticResource SectionHeaderStyle}"
                                       Margin="0" VerticalAlignment="Center" />
                            <Button Grid.Column="1" Content="新建账号" Style="{StaticResource JpAccentButtonStyle}"
                                    VerticalAlignment="Center" Click="AddMail_Click" />
                        </Grid>

                        <TextBlock Text="{x:Bind Vm.MailStatus, Mode=OneWay}" Style="{StaticResource CaptionStyle}"
                                   TextWrapping="Wrap" />
                        <TextBlock Text="{x:Bind Vm.MailEmptyHint, Mode=OneWay}" Style="{StaticResource CaptionStyle}"
                                   TextWrapping="Wrap" />

                        <GridView ItemsSource="{x:Bind Vm.MailAccounts}"
                                  ItemTemplate="{StaticResource MailAccountCard}"
                                  SelectionMode="None"
                                  IsItemClickEnabled="False"
                                  ScrollViewer.VerticalScrollBarVisibility="Disabled">
                            <GridView.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <ItemsWrapGrid Orientation="Horizontal" ItemWidth="372" />
                                </ItemsPanelTemplate>
                            </GridView.ItemsPanel>
                        </GridView>
                    </StackPanel>
                </PivotItem>

                <!-- ── 抖音 ─────────────────────────────────────────── -->
                <PivotItem Header="抖音">
                    <StackPanel Spacing="16" Margin="0,8,0,0">

                        <!-- 状态卡：sidecar 是独立进程，能不能用看它有没有连进来 -->
                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel Spacing="10">
                                <TextBlock Text="sidecar 状态" Style="{StaticResource SectionHeaderStyle}" />
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Grid Width="10" Height="10" VerticalAlignment="Center">
                                        <Ellipse x:Name="DouyinConnectedDot" Fill="#FF6BD08A"
                                                 x:Load="{x:Bind Vm.DouyinConnected, Mode=OneWay}" />
                                        <Ellipse x:Name="DouyinOfflineDot" Fill="#667A6B72"
                                                 x:Load="{x:Bind Vm.DouyinOffline, Mode=OneWay}" />
                                    </Grid>
                                    <TextBlock Text="{x:Bind Vm.DouyinStateText, Mode=OneWay}"
                                               VerticalAlignment="Center" TextWrapping="Wrap" />
                                </StackPanel>
                                <TextBlock Text="{x:Bind Vm.DouyinEndpointText, Mode=OneWay}"
                                           Style="{StaticResource CaptionStyle}" TextWrapping="Wrap" />
                                <TextBlock Text="sidecar 是独立的 Node 进程（douyin-sidecar/），要单独部署并主动连入 /ws/channel —— 本页只改配置，不负责拉起它。"
                                           Style="{StaticResource CaptionStyle}" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>

                        <!-- 配置卡 -->
                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel Spacing="10">
                                <TextBlock Text="抖音配置" Style="{StaticResource SectionHeaderStyle}" />
                                <ToggleSwitch Header="启用抖音通道（关掉时 /ws/channel 不监听）"
                                              IsOn="{x:Bind Vm.DouyinEnabled, Mode=TwoWay}" />

                                <StackPanel Spacing="4">
                                    <PasswordBox Header="Sidecar Token"
                                                 PlaceholderText="留空 = 不改（当前状态见下一行）"
                                                 PasswordRevealMode="Hidden"
                                                 Password="{x:Bind Vm.DouyinTokenInput, Mode=TwoWay}" />
                                    <TextBlock Text="{x:Bind Vm.DouyinTokenStatus, Mode=OneWay}"
                                               Style="{StaticResource CaptionStyle}" TextWrapping="Wrap" />
                                </StackPanel>

                                <TextBox Header="允许的会话（逗号分隔，留空 = 全部；支持 douyin:p* / douyin:g*）"
                                         Text="{x:Bind Vm.DouyinAllowedSessionsInput, Mode=TwoWay}" />

                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <NumberBox Grid.Column="0" Header="发送超时（毫秒）"
                                               Minimum="1000" Maximum="600000" SmallChange="1000"
                                               SpinButtonPlacementMode="Compact"
                                               Value="{x:Bind Vm.DouyinSendTimeoutMs, Mode=TwoWay}" />
                                    <NumberBox Grid.Column="1" Header="文本上限（字符）"
                                               Minimum="100" Maximum="100000" SmallChange="500"
                                               SpinButtonPlacementMode="Compact"
                                               Value="{x:Bind Vm.DouyinMaxTextLength, Mode=TwoWay}" />
                                    <NumberBox Grid.Column="2" Header="查询超时（毫秒）"
                                               Minimum="1000" Maximum="600000" SmallChange="1000"
                                               SpinButtonPlacementMode="Compact"
                                               Value="{x:Bind Vm.DouyinQueryTimeoutMs, Mode=TwoWay}" />
                                </Grid>

                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <Button Content="保存抖音配置" Style="{StaticResource JpAccentButtonStyle}"
                                            Command="{x:Bind Vm.SaveDouyinCommand}" />
                                    <TextBlock Text="{x:Bind Vm.DouyinStatus, Mode=OneWay}"
                                               Style="{StaticResource CaptionStyle}" VerticalAlignment="Center"
                                               TextWrapping="Wrap" MaxWidth="520" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </PivotItem>
            </Pivot>
        </StackPanel>
    </ScrollViewer>
</Page>
