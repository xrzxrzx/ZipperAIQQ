<Page
    x:Class="ZipperAIQQ.Client.Views.ExternalPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:ZipperAIQQ.Client.ViewModels"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="mc">

    <ScrollViewer Padding="32">
        <StackPanel Spacing="16" HorizontalAlignment="Stretch">

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Spacing="4">
                    <TextBlock Text="外部接口" Style="{StaticResource PageTitleStyle}" />
                    <TextBlock Text="WebSocket 接入：反向（外部连入） / 正向（服务端主动连出）"
                               Style="{StaticResource CaptionStyle}" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Bottom">
                    <Button Content="保存" Style="{StaticResource JpAccentButtonStyle}"
                            Command="{x:Bind Vm.SaveCommand}" />
                    <TextBlock Text="{x:Bind Vm.Status, Mode=OneWay}"
                               Style="{StaticResource CaptionStyle}" VerticalAlignment="Center"
                               MaxWidth="320" TextWrapping="Wrap" />
                </StackPanel>
            </Grid>

            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="10">
                    <TextBlock Text="通用" Style="{StaticResource SectionHeaderStyle}" />
                    <ToggleSwitch Header="允许外部应用发消息" IsOn="{x:Bind Vm.AllowSend, Mode=TwoWay}" />
                    <TextBox Header="允许的会话（逗号分隔，留空=全部；支持 qq:p*）"
                             Text="{x:Bind Vm.AllowedSessions, Mode=TwoWay}" />
                </StackPanel>
            </Border>

            <!-- 反向监听：卡片列表（参考 NapCat 网络配置） -->
            <StackPanel Spacing="8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Spacing="2">
                        <TextBlock Text="反向监听" Style="{StaticResource SectionHeaderStyle}" />
                        <TextBlock Text="外部应用连到 host:端口/ws/ext；端口改动需重启服务端生效"
                                   Style="{StaticResource CaptionStyle}" />
                    </StackPanel>
                    <Button Grid.Column="1" Content="新建" Style="{StaticResource JpButtonStyle}"
                            Click="AddReverse_Click" VerticalAlignment="Bottom" />
                </Grid>

                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                    <ItemsControl ItemsSource="{x:Bind Vm.ReverseServers}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" Spacing="12" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:ReverseServerItem">
                                <Border Style="{StaticResource CardStyle}" Width="380" Padding="14">
                                    <StackPanel Spacing="8">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="Websocket 服务器" FontWeight="SemiBold" />
                                            <TextBlock Grid.Column="1" Text="反向" Style="{StaticResource CaptionStyle}" />
                                        </Grid>

                                        <Grid ColumnSpacing="8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="120" />
                                            </Grid.ColumnDefinitions>
                                            <TextBox Grid.Column="0" Header="主机" PlaceholderText="0.0.0.0"
                                                     Text="{x:Bind Host, Mode=TwoWay}" />
                                            <NumberBox Grid.Column="1" Header="端口" Minimum="1" Maximum="65535"
                                                       SpinButtonPlacementMode="Compact"
                                                       Value="{x:Bind Port, Mode=TwoWay}" />
                                        </Grid>

                                        <TextBox Header="Token（留空=沿用）" PlaceholderText="非空时用该 token 鉴权"
                                                 Text="{x:Bind Token, Mode=TwoWay}" />

                                        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                                            <Button Content="删除" Style="{StaticResource JpButtonStyle}"
                                                    Click="RemoveReverse_Click" />
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </StackPanel>

            <!-- 正向连接：卡片列表 -->
            <StackPanel Spacing="8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Spacing="2">
                        <TextBlock Text="正向连接" Style="{StaticResource SectionHeaderStyle}" />
                        <TextBlock Text="服务端主动连到外部应用；保存后立即重连"
                                   Style="{StaticResource CaptionStyle}" />
                    </StackPanel>
                    <Button Grid.Column="1" Content="新建" Style="{StaticResource JpButtonStyle}"
                            Click="AddForward_Click" VerticalAlignment="Bottom" />
                </Grid>

                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                    <ItemsControl ItemsSource="{x:Bind Vm.ForwardServers}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" Spacing="12" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:ForwardServerItem">
                                <Border Style="{StaticResource CardStyle}" Width="380" Padding="14">
                                    <StackPanel Spacing="8">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="Websocket 客户端" FontWeight="SemiBold" />
                                            <TextBlock Grid.Column="1" Text="正向" Style="{StaticResource CaptionStyle}" />
                                        </Grid>

                                        <TextBox Header="WS 地址" PlaceholderText="ws://host:port"
                                                 Text="{x:Bind Url, Mode=TwoWay}" />
                                        <TextBox Header="Token（留空=沿用）" PlaceholderText="非空时用该 token 鉴权"
                                                 Text="{x:Bind Token, Mode=TwoWay}" />

                                        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                                            <Button Content="删除" Style="{StaticResource JpButtonStyle}"
                                                    Click="RemoveForward_Click" />
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </StackPanel>

            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="6">
                    <TextBlock Text="接入说明" Style="{StaticResource SectionHeaderStyle}" />
                    <TextBlock Text="反向端点：ws://主机:端口/ws/ext；鉴权 Bearer token（服务端 token 或该监听块 token）。"
                               Style="{StaticResource CaptionStyle}" TextWrapping="Wrap" />
                    <TextBlock Text="帧协议：hello / event / ack / subscribe / send / ping（docs/05-契约/external-ws.md）。"
                               Style="{StaticResource CaptionStyle}" TextWrapping="Wrap" />
                    <TextBlock Text="外部应用发的消息不会触发 AI 回复；是否允许发送由上方开关与会话白名单控制。"
                               Style="{StaticResource CaptionStyle}" TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
