<Page
    x:Class="ZipperAIQQ.Client.Views.ExternalPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:ZipperAIQQ.Client.ViewModels"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="mc">

    <Page.Resources>
        <DataTemplate x:Key="ServerCard" x:DataType="vm:ExternalServerItem">
            <Border Style="{StaticResource CardStyle}" Width="360" Padding="14" Margin="0,0,12,12">
                <StackPanel Spacing="8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Spacing="2">
                            <TextBlock Text="{x:Bind Name, Mode=OneWay}" FontWeight="SemiBold"
                                       TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{x:Bind TypeText}" Style="{StaticResource CaptionStyle}" />
                        </StackPanel>
                        <ToggleSwitch Grid.Column="1" IsOn="{x:Bind Enabled, Mode=TwoWay}" />
                    </Grid>

                    <Border Background="#1AFFFFFF" CornerRadius="6" Padding="10,8">
                        <StackPanel Spacing="4">
                            <TextBlock Text="{x:Bind EndpointText, Mode=OneWay}" TextWrapping="Wrap" />
                            <TextBlock Text="{x:Bind TokenText, Mode=OneWay}"
                                       Style="{StaticResource CaptionStyle}" />
                        </StackPanel>
                    </Border>

                    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                        <Button Content="编辑" Style="{StaticResource JpButtonStyle}"
                                Click="EditServer_Click" />
                        <Button Content="删除" Style="{StaticResource JpButtonStyle}"
                                Click="RemoveServer_Click" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </DataTemplate>
    </Page.Resources>

    <ScrollViewer Padding="32">
        <StackPanel Spacing="16" HorizontalAlignment="Stretch">

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Spacing="4">
                    <TextBlock Text="外部接口" Style="{StaticResource PageTitleStyle}" />
                    <TextBlock Text="WebSocket 接入：反向（外部连入） / 正向（服务端主动连出）"
                               Style="{StaticResource CaptionStyle}" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Bottom">
                    <Button Content="新建" Style="{StaticResource JpButtonStyle}">
                        <Button.Flyout>
                            <MenuFlyout>
                                <MenuFlyoutItem Text="Websocket 服务器（反向）" Click="AddReverse_Click" />
                                <MenuFlyoutItem Text="Websocket 客户端（正向）" Click="AddForward_Click" />
                            </MenuFlyout>
                        </Button.Flyout>
                    </Button>
                    <Button Content="保存" Style="{StaticResource JpAccentButtonStyle}"
                            Command="{x:Bind Vm.SaveCommand}" />
                </StackPanel>
            </Grid>

            <TextBlock Text="{x:Bind Vm.Status, Mode=OneWay}" Style="{StaticResource CaptionStyle}"
                       TextWrapping="Wrap" />

            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="10">
                    <TextBlock Text="通用" Style="{StaticResource SectionHeaderStyle}" />
                    <ToggleSwitch Header="允许外部应用发消息" IsOn="{x:Bind Vm.AllowSend, Mode=TwoWay}" />
                    <TextBox Header="允许的会话（逗号分隔，留空=全部；支持 qq:p*）"
                             Text="{x:Bind Vm.AllowedSessions, Mode=TwoWay}" />
                </StackPanel>
            </Border>

            <Pivot>
                <PivotItem Header="全部">
                    <GridView ItemsSource="{x:Bind Vm.AllServers}"
                              ItemTemplate="{StaticResource ServerCard}"
                              SelectionMode="None"
                              IsItemClickEnabled="False"
                              ScrollViewer.VerticalScrollBarVisibility="Disabled"
                              Margin="0,8,0,0">
                        <GridView.ItemsPanel>
                            <ItemsPanelTemplate>
                                <ItemsWrapGrid Orientation="Horizontal" ItemWidth="372" />
                            </ItemsPanelTemplate>
                        </GridView.ItemsPanel>
                    </GridView>
                </PivotItem>

                <PivotItem Header="反向监听">
                    <GridView ItemsSource="{x:Bind Vm.ReverseServers}"
                              ItemTemplate="{StaticResource ServerCard}"
                              SelectionMode="None"
                              IsItemClickEnabled="False"
                              ScrollViewer.VerticalScrollBarVisibility="Disabled"
                              Margin="0,8,0,0">
                        <GridView.ItemsPanel>
                            <ItemsPanelTemplate>
                                <ItemsWrapGrid Orientation="Horizontal" ItemWidth="372" />
                            </ItemsPanelTemplate>
                        </GridView.ItemsPanel>
                    </GridView>
                </PivotItem>

                <PivotItem Header="正向连接">
                    <GridView ItemsSource="{x:Bind Vm.ForwardServers}"
                              ItemTemplate="{StaticResource ServerCard}"
                              SelectionMode="None"
                              IsItemClickEnabled="False"
                              ScrollViewer.VerticalScrollBarVisibility="Disabled"
                              Margin="0,8,0,0">
                        <GridView.ItemsPanel>
                            <ItemsPanelTemplate>
                                <ItemsWrapGrid Orientation="Horizontal" ItemWidth="372" />
                            </ItemsPanelTemplate>
                        </GridView.ItemsPanel>
                    </GridView>
                </PivotItem>
            </Pivot>

            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="6">
                    <TextBlock Text="接入说明" Style="{StaticResource SectionHeaderStyle}" />
                    <TextBlock Text="反向端点：ws://主机:端口/ws/ext；鉴权 Bearer token（服务端 token 或该监听块 token）。"
                               Style="{StaticResource CaptionStyle}" TextWrapping="Wrap" />
                    <TextBlock Text="帧协议：hello / event / ack / subscribe / send / ping（docs/05-契约/external-ws.md）。"
                               Style="{StaticResource CaptionStyle}" TextWrapping="Wrap" />
                    <TextBlock Text="外部应用发的消息不会触发 AI 回复；是否允许发送由上方开关与会话白名单控制。"
                               Style="{StaticResource CaptionStyle}" TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
