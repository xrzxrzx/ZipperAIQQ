<Page
    x:Class="ZipperAIQQ.Client.Views.LogsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:dto="using:ZipperAIQQ.Client.Dto"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="mc">

    <Grid Padding="32" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock Text="服务端日志" Style="{StaticResource PageTitleStyle}" />

        <StackPanel Grid.Row="1" Spacing="8">
            <StackPanel Orientation="Horizontal" Spacing="10">
                <DatePicker Header="开始" SelectedDate="{x:Bind Vm.From, Mode=TwoWay}" />
                <DatePicker Header="结束" SelectedDate="{x:Bind Vm.To, Mode=TwoWay}" />
                <ComboBox Header="级别" MinWidth="120"
                          ItemsSource="{x:Bind Vm.Levels}"
                          SelectedItem="{x:Bind Vm.SelectedLevel, Mode=TwoWay}" />
                <TextBox Header="关键词" MinWidth="240" Text="{x:Bind Vm.Keyword, Mode=TwoWay}" />
                <Button Content="查询" Style="{StaticResource JpAccentButtonStyle}"
                        Command="{x:Bind Vm.QueryCommand}" VerticalAlignment="Bottom" />
                <TextBlock Text="{x:Bind Vm.Status, Mode=OneWay}"
                           Style="{StaticResource CaptionStyle}" VerticalAlignment="Center"
                           TextWrapping="Wrap" />
            </StackPanel>
        </StackPanel>

        <Border Grid.Row="2" Style="{StaticResource CardStyle}" Padding="8">
            <ListView ItemsSource="{x:Bind Vm.Lines}" SelectionMode="None">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="dto:LogLineDto">
                        <StackPanel Padding="4,2">
                            <TextBlock Text="{x:Bind Display}" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                            <TextBlock Text="{x:Bind File}" Style="{StaticResource CaptionStyle}" FontSize="10" />
                        </StackPanel>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Border>
    </Grid>
</Page>

