<Page
    x:Class="ZipperAIQQ.Client.Views.EndpointsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="mc">

    <ScrollViewer Padding="32">
        <StackPanel Spacing="16" HorizontalAlignment="Stretch">

            <TextBlock Text="模型配置" Style="{StaticResource PageTitleStyle}" />
            <TextBlock Text="一把 DeepSeek Key 走全链路（对话 / 搜索 / OCR / ASR / TTS）；两个固定端点只有地址与模型"
                       Style="{StaticResource CaptionStyle}" Margin="0,-8,0,4" />

            <!-- 全链路唯一的一把 key（问题记录 06 §5） -->
            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="10">
                    <TextBlock Text="DeepSeek API Key（全链路唯一）" Style="{StaticResource SectionHeaderStyle}" />
                    <TextBlock Text="对话、网页搜索/抓取、OCR、ASR、TTS 共用这一把；保存后明文立即入库为密文，界面只显示掩码。"
                               Style="{StaticResource CaptionStyle}" TextWrapping="Wrap" />

                    <PasswordBox x:Name="ApiKeyBox" Header="API Key（留空 = 不改）"
                                 PasswordChanged="ApiKey_PasswordChanged" />

                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <Button Content="保存 Key" Style="{StaticResource JpAccentButtonStyle}"
                                Command="{x:Bind Vm.SaveApiKeyCommand}" />
                        <TextBlock Text="{x:Bind Vm.ApiKeyStatus, Mode=OneWay}"
                                   Style="{StaticResource CaptionStyle}" VerticalAlignment="Center"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- 两个端点左右并列（窄窗口时每列最小 380） -->
            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MinWidth="380" />
                    <ColumnDefinition Width="*" MinWidth="380" />
                </Grid.ColumnDefinitions>

                <!-- 普通 LLM -->
                <Border Grid.Column="0" Style="{StaticResource CardStyle}">
                    <StackPanel Spacing="10">
                        <TextBlock Text="普通 LLM（primary）" Style="{StaticResource SectionHeaderStyle}" />
                        <TextBlock Text="负责正常对话与工具调用"
                                   Style="{StaticResource CaptionStyle}" TextWrapping="Wrap" />

                        <TextBox Header="BaseUrl" Text="{x:Bind Vm.LlmBaseUrl, Mode=TwoWay}" />
                        <TextBox Header="模型" Text="{x:Bind Vm.LlmModel, Mode=TwoWay}" />

                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <Button Content="保存普通 LLM" Style="{StaticResource JpAccentButtonStyle}"
                                    Command="{x:Bind Vm.SaveLlmCommand}" />
                            <TextBlock Text="{x:Bind Vm.LlmStatus, Mode=OneWay}"
                                       Style="{StaticResource CaptionStyle}" VerticalAlignment="Center" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- JEV -->
                <Border Grid.Column="1" Style="{StaticResource CardStyle}">
                    <StackPanel Spacing="10">
                        <TextBlock Text="JEV 判断模型（judge）" Style="{StaticResource SectionHeaderStyle}" />
                        <TextBlock Text="只在「回复模式 = jev」时使用，判断此刻该不该开口"
                                   Style="{StaticResource CaptionStyle}" TextWrapping="Wrap" />

                        <TextBox Header="BaseUrl" Text="{x:Bind Vm.JudgeBaseUrl, Mode=TwoWay}" />
                        <TextBox Header="模型" Text="{x:Bind Vm.JudgeModel, Mode=TwoWay}" />

                        <TextBlock Text="key 收敛后不再单独填写：优先用它自己的留档密文，没有则回落全链路那把；灵敏度在「运行与行为」页配置"
                                   Style="{StaticResource CaptionStyle}" TextWrapping="Wrap" />

                        <Button Content="保存 JEV" Style="{StaticResource JpAccentButtonStyle}"
                                Command="{x:Bind Vm.SaveJudgeCommand}" HorizontalAlignment="Left" />

                        <TextBlock Text="{x:Bind Vm.JudgeStatus, Mode=OneWay}"
                                   Style="{StaticResource CaptionStyle}" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- 对话增强：DeepSeek 全家桶的服务端增强（T2.6） -->
            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="10">
                    <TextBlock Text="对话增强（DeepSeek 全家桶）" Style="{StaticResource SectionHeaderStyle}" />
                    <TextBlock Text="交给服务端：联网搜索、阅读链接、内容安全、会话标题。保存后立即生效（会重建 LLM 客户端）。"
                               Style="{StaticResource CaptionStyle}" TextWrapping="Wrap" />

                    <ToggleSwitch Header="联网搜索（deepseek_web_search）"
                                  IsOn="{x:Bind Vm.EnhanceWebSearch, Mode=TwoWay}" />
                    <ToggleSwitch Header="阅读链接（deepseek_read_url）"
                                  IsOn="{x:Bind Vm.EnhanceReadUrl, Mode=TwoWay}" />
                    <ToggleSwitch Header="内容安全 = high（命中风险时以拒答结束）"
                                  IsOn="{x:Bind Vm.EnhanceSafetyCheck, Mode=TwoWay}" />
                    <ToggleSwitch Header="会话标题（回答结束时生成短标题）"
                                  IsOn="{x:Bind Vm.EnhanceTitle, Mode=TwoWay}" />

                    <TextBlock Text="{x:Bind Vm.EnhanceNote, Mode=OneWay}"
                               Style="{StaticResource CaptionStyle}" TextWrapping="Wrap"
                               Foreground="{ThemeResource JpAccentBrush}" />

                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <Button Content="保存对话增强" Style="{StaticResource JpAccentButtonStyle}"
                                Command="{x:Bind Vm.SaveEnhanceCommand}" />
                        <TextBlock Text="{x:Bind Vm.EnhanceStatus, Mode=OneWay}"
                                   Style="{StaticResource CaptionStyle}" VerticalAlignment="Center"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- 网页搜索：地址独立，key 与全链路共用 -->
            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="10">
                    <TextBlock Text="网页搜索（地址独立）" Style="{StaticResource SectionHeaderStyle}" />
                    <TextBlock Text="搜索服务可以换地址 / 换供应商，不影响对话模型；key 与全链路共用那一把。"
                               Style="{StaticResource CaptionStyle}" TextWrapping="Wrap" />

                    <ToggleSwitch Header="启用网页搜索" IsOn="{x:Bind Vm.SearchEnabled, Mode=TwoWay}" />
                    <TextBox Header="BaseUrl" Text="{x:Bind Vm.SearchBaseUrl, Mode=TwoWay}" />

                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <Button Content="保存网页搜索" Style="{StaticResource JpAccentButtonStyle}"
                                Command="{x:Bind Vm.SaveSearchCommand}" />
                        <TextBlock Text="{x:Bind Vm.SearchStatus, Mode=OneWay}"
                                   Style="{StaticResource CaptionStyle}" VerticalAlignment="Center"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
