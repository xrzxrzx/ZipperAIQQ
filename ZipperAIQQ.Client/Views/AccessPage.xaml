<Page
    x:Class="ZipperAIQQ.Client.Views.AccessPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:ZipperAIQQ.Client.Controls"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="mc">

    <ScrollViewer Padding="32">
        <StackPanel Spacing="16" HorizontalAlignment="Stretch">

            <TextBlock Text="人员与名单" Style="{StaticResource PageTitleStyle}" />
            <TextBlock Text="人员管「谁能指挥它动手」，名单管「它愿意理谁」—— 两张卡分开保存"
                       Style="{StaticResource CaptionStyle}" Margin="0,-8,0,4" />

            <!-- 平台（S3-C C7）：人员与名单按平台分开配置，切换后整页重拉 -->
            <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock Text="平台" Style="{StaticResource CaptionStyle}" VerticalAlignment="Center" />
                <ComboBox MinWidth="160"
                          VerticalAlignment="Center"
                          ItemsSource="{x:Bind Vm.Platforms}"
                          SelectedItem="{x:Bind Vm.SelectedPlatform, Mode=TwoWay}" />
                <TextBlock Text="{x:Bind Vm.PlatformStatus, Mode=OneWay}"
                           Style="{StaticResource CaptionStyle}" VerticalAlignment="Center"
                           MaxWidth="460" TextWrapping="Wrap" />
            </StackPanel>

            <!-- 人员（#19） -->
            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="12">
                    <TextBlock Text="人员" Style="{StaticResource SectionHeaderStyle}" />

                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="主人" VerticalAlignment="Center" />
                        <controls:FilterableComboBox Grid.Column="1"
                                                     ItemsSource="{x:Bind Vm.OwnerOptions}"
                                                     SelectedItem="{x:Bind Vm.SelectedOwnerDisplay, Mode=TwoWay}"
                                                     PlaceholderText="搜好友昵称…" />
                    </Grid>

                    <TextBlock Text="管理员（可多选）" FontWeight="SemiBold" />
                    <controls:MultiSelectList ItemsSource="{x:Bind Vm.AdminCandidates}"
                                              SelectedValues="{x:Bind Vm.AdminsSelected, Mode=OneWay}" />

                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <Button Content="保存人员" Style="{StaticResource JpAccentButtonStyle}"
                                Command="{x:Bind Vm.SavePeopleCommand}" />
                        <TextBlock Text="{x:Bind Vm.PeopleStatus, Mode=OneWay}"
                                   Style="{StaticResource CaptionStyle}" VerticalAlignment="Center"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- 名单（#20 #24 #26） -->
            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="12">
                    <TextBlock Text="名单" Style="{StaticResource SectionHeaderStyle}" />
                    <TextBlock Text="白名单：只收名单内的会话；黑名单：排除名单内的会话。同一条目不能两边都加。"
                               Style="{StaticResource CaptionStyle}" TextWrapping="Wrap" />

                    <TextBlock Text="白名单" FontWeight="SemiBold" />
                    <controls:MultiSelectList ItemsSource="{x:Bind Vm.ListCandidates}"
                                              SelectedValues="{x:Bind Vm.WhitelistSelected, Mode=OneWay}" />

                    <TextBlock Text="黑名单" FontWeight="SemiBold" />
                    <controls:MultiSelectList ItemsSource="{x:Bind Vm.ListCandidates}"
                                              SelectedValues="{x:Bind Vm.BlacklistSelected, Mode=OneWay}" />

                    <TextBlock Text="主人放行（自动，不受名单影响）" FontWeight="SemiBold" />
                    <TextBlock Text="{x:Bind Vm.AlwaysAllowText, Mode=OneWay}"
                               Style="{StaticResource CaptionStyle}" TextWrapping="Wrap" />

                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <Button Content="保存名单" Style="{StaticResource JpAccentButtonStyle}"
                                Click="SaveLists_Click" />
                        <TextBlock Text="{x:Bind Vm.ListStatus, Mode=OneWay}"
                                   Style="{StaticResource CaptionStyle}" VerticalAlignment="Center"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
