<Page
    x:Class="ZipperAIQQ.Client.Views.StatusPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="mc">

    <ScrollViewer Padding="32">
        <StackPanel Spacing="16" MaxWidth="900" HorizontalAlignment="Left">

            <TextBlock Text="状态" Style="{StaticResource PageTitleStyle}" />
            <TextBlock Text="服务端的运行状况与连接信息" Style="{StaticResource CaptionStyle}" Margin="0,-8,0,8" />

            <!-- 连接卡片 -->
            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="12">
                    <TextBlock Text="连接" Style="{StaticResource SectionHeaderStyle}" />
                    <Grid ColumnSpacing="12" RowSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" Header="服务器" Width="280"
                                 Text="{x:Bind Vm.ServerUrl, Mode=TwoWay}" />
                        <PasswordBox Grid.Column="1" Header="Token（loopback 可留空）" Width="280"
                                     HorizontalAlignment="Left"
                                     PasswordChanged="TokenBox_PasswordChanged" />
                    </Grid>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Content="连接" Style="{StaticResource JpAccentButtonStyle}"
                                Command="{x:Bind Vm.ConnectCommand}" />
                        <Button Content="刷新状态" Style="{StaticResource JpButtonStyle}" Command="{x:Bind Vm.RefreshStatusCommand}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- 状态卡片 -->
            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="12">
                    <TextBlock Text="运行信息" Style="{StaticResource SectionHeaderStyle}" />
                    <TextBlock Text="{x:Bind Vm.StatusText, Mode=OneWay}"
                               TextWrapping="Wrap" IsTextSelectionEnabled="True" LineHeight="24" />
                </StackPanel>
            </Border>

            <TextBlock Text="{x:Bind Vm.StatusLine, Mode=OneWay}"
                       Style="{StaticResource CaptionStyle}" TextWrapping="Wrap" />
        </StackPanel>
    </ScrollViewer>
</Page>
