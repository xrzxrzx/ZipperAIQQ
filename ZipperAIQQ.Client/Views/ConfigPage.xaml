<Page
    x:Class="ZipperAIQQ.Client.Views.ConfigPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="mc">

    <ScrollViewer Padding="32">
        <StackPanel Spacing="16" MaxWidth="720" HorizontalAlignment="Left">

            <TextBlock Text="配置" Style="{StaticResource PageTitleStyle}" />
            <TextBlock Text="模型端点由服务端加密保存；这里的 key 只写不回显"
                       Style="{StaticResource CaptionStyle}" Margin="0,-8,0,8" />

            <!-- 当前配置 -->
            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="12">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="当前生效" Style="{StaticResource SectionHeaderStyle}" VerticalAlignment="Center" />
                        <Button Content="读取" Style="{StaticResource JpButtonStyle}" Command="{x:Bind Vm.LoadConfigCommand}" />
                    </StackPanel>
                    <TextBlock Text="{x:Bind Vm.ConfigText, Mode=OneWay}"
                               TextWrapping="Wrap" IsTextSelectionEnabled="True" LineHeight="22" />
                </StackPanel>
            </Border>

            <!-- 编辑端点 -->
            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="12">
                    <TextBlock Text="编辑端点" Style="{StaticResource SectionHeaderStyle}" />

                    <Grid ColumnSpacing="12" RowSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBox Grid.Row="0" Grid.Column="0" Header="端点名" Text="{x:Bind Vm.ConfigName, Mode=TwoWay}" />
                        <TextBox Grid.Row="0" Grid.Column="1" Header="模型" Text="{x:Bind Vm.ConfigModel, Mode=TwoWay}" />
                        <TextBox Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Header="BaseUrl"
                                 Text="{x:Bind Vm.ConfigBaseUrl, Mode=TwoWay}" />
                        <PasswordBox Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2"
                                     Header="API Key（留空 = 不修改）"
                                     PasswordChanged="KeyBox_PasswordChanged" />
                    </Grid>

                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Content="保存（服务端即时生效）" Style="{StaticResource JpAccentButtonStyle}"
                                Command="{x:Bind Vm.SaveConfigCommand}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <TextBlock Text="{x:Bind Vm.StatusLine, Mode=OneWay}"
                       Style="{StaticResource CaptionStyle}" TextWrapping="Wrap" />
        </StackPanel>
    </ScrollViewer>
</Page>
