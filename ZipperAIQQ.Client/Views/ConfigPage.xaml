<Page
    x:Class="ZipperAIQQ.Client.Views.ConfigPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:ZipperAIQQ.Client.ViewModels"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="mc">

    <ScrollViewer Padding="32">
        <StackPanel Spacing="16" MaxWidth="1200" HorizontalAlignment="Stretch">

            <TextBlock Text="配置" Style="{StaticResource PageTitleStyle}" />
            <TextBlock Text="模型端点由服务端加密保存；数值参数保存后会写审计（范围由服务端校验）"
                       Style="{StaticResource CaptionStyle}" Margin="0,-8,0,4" />

            <Grid ColumnSpacing="20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- 左：模型端点 -->
                <StackPanel Grid.Column="0" Spacing="16">

                    <Border Style="{StaticResource CardStyle}">
                        <StackPanel Spacing="12">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="当前生效" Style="{StaticResource SectionHeaderStyle}" VerticalAlignment="Center" />
                                <Button Content="读取" Style="{StaticResource JpButtonStyle}"
                                        Command="{x:Bind Vm.LoadConfigCommand}" />
                            </StackPanel>
                            <TextBlock Text="{x:Bind Vm.ConfigText, Mode=OneWay}"
                                       TextWrapping="Wrap" IsTextSelectionEnabled="True" LineHeight="22" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource CardStyle}">
                        <StackPanel Spacing="12">
                            <TextBlock Text="编辑端点" Style="{StaticResource SectionHeaderStyle}" />

                            <Grid ColumnSpacing="12" RowSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <TextBox Grid.Row="0" Grid.Column="0" Header="端点名"
                                         Text="{x:Bind Vm.ConfigName, Mode=TwoWay}" />
                                <TextBox Grid.Row="0" Grid.Column="1" Header="模型"
                                         Text="{x:Bind Vm.ConfigModel, Mode=TwoWay}" />
                                <TextBox Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Header="BaseUrl"
                                         Text="{x:Bind Vm.ConfigBaseUrl, Mode=TwoWay}" />
                                <PasswordBox Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2"
                                             Header="API Key（留空 = 不修改；服务端加密保存，永不回显）"
                                             PasswordChanged="KeyBox_PasswordChanged" />
                            </Grid>

                            <Button Content="保存端点（服务端即时热更新）"
                                    Style="{StaticResource JpAccentButtonStyle}"
                                    Command="{x:Bind Vm.SaveConfigCommand}" HorizontalAlignment="Left" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- 右：数值运行参数 -->
                <StackPanel Grid.Column="1" Spacing="16">
                    <Border Style="{StaticResource CardStyle}">
                        <StackPanel Spacing="12">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="运行参数" Style="{StaticResource SectionHeaderStyle}" VerticalAlignment="Center" />
                                <Button Content="读取" Style="{StaticResource JpButtonStyle}"
                                        Command="{x:Bind Vm.LoadSettingsCommand}" />
                            </StackPanel>

                            <TextBlock Text="越界会被服务端拒绝；改完点保存写入审计。"
                                       Style="{StaticResource CaptionStyle}" />

                            <ItemsControl ItemsSource="{x:Bind Vm.Settings}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:SettingItem">
                                        <Grid ColumnSpacing="12" Margin="0,7">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="160" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="{x:Bind Label}" Style="{StaticResource BodyStyle}" />
                                                <TextBlock Text="{x:Bind Hint}" Style="{StaticResource CaptionStyle}" />
                                            </StackPanel>
                                            <NumberBox Grid.Column="1"
                                                       Value="{x:Bind Value, Mode=TwoWay}"
                                                       Minimum="{x:Bind Min}"
                                                       Maximum="{x:Bind Max}"
                                                       SpinButtonPlacementMode="Compact"
                                                       HorizontalAlignment="Stretch" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <Button Content="保存运行参数"
                                    Style="{StaticResource JpAccentButtonStyle}"
                                    Command="{x:Bind Vm.SaveSettingsCommand}" HorizontalAlignment="Left" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>

            <TextBlock Text="{x:Bind Vm.StatusLine, Mode=OneWay}"
                       Style="{StaticResource CaptionStyle}" TextWrapping="Wrap" />
        </StackPanel>
    </ScrollViewer>
</Page>
