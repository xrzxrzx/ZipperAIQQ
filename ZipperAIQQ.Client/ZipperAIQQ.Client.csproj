<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>ZipperAIQQ.Client</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- 必须同时支持 AnyCPU 与 x64：
         VS 的解决方案配置默认是 Any CPU，项目只声明 x64 时会被判定为「不构建」，
         表现就是「无法启动调试 / 无法启动启动项目」 -->
    <Platforms>AnyCPU;x64</Platforms>
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
    <!-- WinUI3 需要：UseWinUI 打开 XAML 编译；unpackaged 免 MSIX -->
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>false</WindowsAppSDKSelfContained>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- WinUI3 生成器需要显式指定，否则 XAML 类找不到 -->
    <EnableMsixTooling>true</EnableMsixTooling>
  </PropertyGroup>

  <!-- AnyCPU 时固定 RID：WinUI3 的 apphost 需要具体架构 -->
  <PropertyGroup Condition="'$(Platform)' == 'AnyCPU'">
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.5.1" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.26100.4948" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.13" />
  </ItemGroup>

  <!-- 客户端自己维护一份 wire DTO（架构 §3.8），**不引用** Server / Agent -->
  <ItemGroup>
  </ItemGroup>

</Project>
