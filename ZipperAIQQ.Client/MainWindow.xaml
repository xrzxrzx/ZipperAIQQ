<Window
    x:Class="ZipperAIQQ.Client.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:ZipperAIQQ.Client.ViewModels"
    xmlns:dto="using:ZipperAIQQ.Client.Dto"
    Title="ZipperAIQQ 控制台">

    <Grid Padding="12" RowSpacing="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 连接条：客户端只需要「服务器地址 + token」（FR-8.3） -->
        <StackPanel Orientation="Horizontal" Spacing="8">
            <TextBox Header="服务器" Width="260" Text="{x:Bind Vm.ServerUrl, Mode=TwoWay}" />
            <PasswordBox x:Name="TokenBox" Header="Token（留空=loopback 免验）" Width="240"
                         PasswordChanged="TokenBox_PasswordChanged" />
            <Button Content="连接" Command="{x:Bind Vm.ConnectCommand}" VerticalAlignment="Bottom" />
        </StackPanel>

        <TabView Grid.Row="1">
            <TabViewItem Header="状态" IsClosable="False">
                <ScrollViewer Padding="12">
                    <StackPanel Spacing="8">
                        <Button Content="刷新状态" Command="{x:Bind Vm.RefreshStatusCommand}" />
                        <TextBlock Text="{x:Bind Vm.StatusText, Mode=OneWay}"
                                   TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                    </StackPanel>
                </ScrollViewer>
            </TabViewItem>

            <TabViewItem Header="会话" IsClosable="False">
                <Grid ColumnSpacing="8" Padding="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="280" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Spacing="8">
                        <Button Content="刷新会话" Command="{x:Bind Vm.LoadSessionsCommand}" />
                        <ListView ItemsSource="{x:Bind Vm.Sessions}"
                                  SelectedItem="{x:Bind Vm.SelectedSession, Mode=TwoWay}"
                                  Height="420">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="dto:SessionDto">
                                    <StackPanel>
                                        <TextBlock Text="{x:Bind SessionId}" FontWeight="SemiBold" />
                                        <TextBlock Text="{x:Bind LastMessageText}" FontSize="11" Opacity="0.7" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Spacing="8">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Content="加载消息" Command="{x:Bind Vm.LoadMessagesCommand}" />
                            <Button Content="导出到文件" Command="{x:Bind Vm.ExportCommand}" />
                            <TextBlock Text="{x:Bind Vm.SessionStatus, Mode=OneWay}" VerticalAlignment="Center" />
                        </StackPanel>
                        <ListView ItemsSource="{x:Bind Vm.Messages}" Height="420">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="dto:MessageDto">
                                    <TextBlock Text="{x:Bind Display}" TextWrapping="Wrap" />
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </StackPanel>
                </Grid>
            </TabViewItem>

            <TabViewItem Header="配置" IsClosable="False">
                <ScrollViewer Padding="12">
                    <StackPanel Spacing="8" MaxWidth="620" HorizontalAlignment="Left">
                        <Button Content="读取当前配置" Command="{x:Bind Vm.LoadConfigCommand}" />
                        <TextBox Header="端点名" Text="{x:Bind Vm.ConfigName, Mode=TwoWay}" />
                        <TextBox Header="BaseUrl" Text="{x:Bind Vm.ConfigBaseUrl, Mode=TwoWay}" />
                        <TextBox Header="模型" Text="{x:Bind Vm.ConfigModel, Mode=TwoWay}" />
                        <PasswordBox x:Name="ConfigKeyBox"
                                     Header="API Key（留空 = 不修改；服务端加密保存，永不回显）"
                                     PasswordChanged="ConfigKeyBox_PasswordChanged" />
                        <Button Content="保存（服务端即时热更新）" Command="{x:Bind Vm.SaveConfigCommand}" />
                        <TextBlock Text="{x:Bind Vm.ConfigText, Mode=OneWay}"
                                   TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                    </StackPanel>
                </ScrollViewer>
            </TabViewItem>

            <TabViewItem Header="审计" IsClosable="False">
                <Grid Padding="12" RowSpacing="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Button Content="刷新审计" Command="{x:Bind Vm.LoadAuditCommand}" />
                    <ListView Grid.Row="1" ItemsSource="{x:Bind Vm.Audits}">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="dto:AuditDto">
                                <TextBlock Text="{x:Bind Display}" />
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </TabViewItem>
        </TabView>

        <!-- 状态条：所有失败原因都落在这里，不让界面变成哑巴 -->
        <TextBlock Grid.Row="2" Text="{x:Bind Vm.StatusLine, Mode=OneWay}"
                   TextWrapping="Wrap" Opacity="0.85" />
    </Grid>
</Window>
