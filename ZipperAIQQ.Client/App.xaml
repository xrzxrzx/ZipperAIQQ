<Application
    x:Class="ZipperAIQQ.Client.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>

            <!-- ═══════════════════════════════════════════════
                 日系 · 粉嫩主题（参考 NapCat WebUI 的浅色卡片 + 粉色强调）
                 暗色：夜樱粉紫  ·  浅色：樱白粉
                 ═══════════════════════════════════════════════ -->
            <ResourceDictionary.ThemeDictionaries>

                <ResourceDictionary x:Key="Light">
                    <!-- 背景：更粉的樱白渐变 -->
                    <LinearGradientBrush x:Key="JpBackgroundBrush" StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#FFF5FA" Offset="0" />
                        <GradientStop Color="#FDEFFA" Offset="0.5" />
                        <GradientStop Color="#FFF0F6" Offset="1" />
                    </LinearGradientBrush>

                    <SolidColorBrush x:Key="JpCardBrush" Color="#EEFFFFFF" />
                    <SolidColorBrush x:Key="JpCardHoverBrush" Color="#FFFFFFFF" />
                    <SolidColorBrush x:Key="JpCardStrokeBrush" Color="#33FF7FB0" />

                    <!-- 对话框底：**不透明**（卡片可以半透明透出背景，对话框不行——
                         半透明会让主窗体内容从弹窗底下透出来，看着眼花） -->
                    <SolidColorBrush x:Key="JpDialogSurfaceBrush" Color="#FFFDF7FA" />

                    <!-- 强调：樱粉 -->
                    <SolidColorBrush x:Key="JpAccentBrush" Color="#FF7FB0" />
                    <SolidColorBrush x:Key="JpAccentSoftBrush" Color="#33FF7FB0" />
                    <SolidColorBrush x:Key="JpAccentSecondaryBrush" Color="#C9A0DC" />

                    <SolidColorBrush x:Key="JpTextBrush" Color="#4A3A44" />
                    <SolidColorBrush x:Key="JpSubtleTextBrush" Color="#9A8490" />

                    <SolidColorBrush x:Key="JpChromeBrush" Color="#40FFFFFF" />
                    <SolidColorBrush x:Key="JpSelectionBrush" Color="#2EFF7FB0" />

                    <!--
                      开关（ToggleSwitch）开启态配色。
                      ⚠️ 这里能生效的原因：模板里是 {ThemeResource ToggleSwitchFillOn}，
                      ThemeResource 会先查 App 资源再落到框架默认值 —— 所以覆盖**这一层**才是确定有效的。
                      （对比：AccentButtonBackground 在 generic.xaml 里是 StaticResource 别名，
                        解析时就绑死了，覆盖它没用 —— 这也是上次失败的原因。）
                    -->
                    <SolidColorBrush x:Key="ToggleSwitchFillOn" Color="#FFF31260" />
                    <SolidColorBrush x:Key="ToggleSwitchFillOnPointerOver" Color="#FFF75F94" />
                    <SolidColorBrush x:Key="ToggleSwitchFillOnPressed" Color="#FFD31256" />
                    <SolidColorBrush x:Key="ToggleSwitchStrokeOn" Color="#FFF31260" />
                    <SolidColorBrush x:Key="ToggleSwitchStrokeOnPointerOver" Color="#FFF75F94" />
                    <SolidColorBrush x:Key="ToggleSwitchStrokeOnPressed" Color="#FFD31256" />
                </ResourceDictionary>

                <ResourceDictionary x:Key="Dark">
                    <!-- 背景：夜樱粉紫（不是纯灰紫，带粉调） -->
                    <LinearGradientBrush x:Key="JpBackgroundBrush" StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#2A1622" Offset="0" />
                        <GradientStop Color="#331A2E" Offset="0.5" />
                        <GradientStop Color="#241322" Offset="1" />
                    </LinearGradientBrush>

                    <SolidColorBrush x:Key="JpCardBrush" Color="#CC3A2434" />
                    <SolidColorBrush x:Key="JpCardHoverBrush" Color="#DD452B3E" />
                    <SolidColorBrush x:Key="JpCardStrokeBrush" Color="#40FF9EC4" />

                    <!-- 对话框底：**不透明**，近黑（对标 NapCat 面板底色 #18181B） -->
                    <SolidColorBrush x:Key="JpDialogSurfaceBrush" Color="#FF18181B" />

                    <!-- 强调：亮樱粉（暗底上更醒目） -->
                    <SolidColorBrush x:Key="JpAccentBrush" Color="#FF8FBE" />
                    <SolidColorBrush x:Key="JpAccentSoftBrush" Color="#33FF8FBE" />
                    <SolidColorBrush x:Key="JpAccentSecondaryBrush" Color="#C9A0DC" />

                    <!-- 文字：粉白（原 #EDE9F2 偏灰，粉嫩化后偏粉） -->
                    <SolidColorBrush x:Key="JpTextBrush" Color="#F8EAEF" />
                    <SolidColorBrush x:Key="JpSubtleTextBrush" Color="#C4A6B8" />

                    <SolidColorBrush x:Key="JpChromeBrush" Color="#33FFFFFF" />
                    <SolidColorBrush x:Key="JpSelectionBrush" Color="#2EFF8FBE" />

                    <!-- 开关开启态：粉（与按钮同一套 #F31260，见 Light 分支的说明） -->
                    <SolidColorBrush x:Key="ToggleSwitchFillOn" Color="#FFF31260" />
                    <SolidColorBrush x:Key="ToggleSwitchFillOnPointerOver" Color="#FFF75F94" />
                    <SolidColorBrush x:Key="ToggleSwitchFillOnPressed" Color="#FFD31256" />
                    <SolidColorBrush x:Key="ToggleSwitchStrokeOn" Color="#FFF31260" />
                    <SolidColorBrush x:Key="ToggleSwitchStrokeOnPointerOver" Color="#FFF75F94" />
                    <SolidColorBrush x:Key="ToggleSwitchStrokeOnPressed" Color="#FFD31256" />
                </ResourceDictionary>

            </ResourceDictionary.ThemeDictionaries>

            <!-- ═══════════════════════════════════════════════
                 强调色族（对标 NapCat WebUI 的粉 #F31260）
                 放在**顶层**：ToggleSwitch / CheckBox / 选中态等取 {ThemeResource SystemAccentColor*}
                 的地方会先查 App 资源，于是整体偏向同一个粉。
                 （上次改 ThemeDictionaries 里的 AccentButton* 无效，因为那是 StaticResource 别名，
                   在 generic.xaml 解析时就绑死到系统强调色了；这条路不再走。）
                 ═══════════════════════════════════════════════ -->
            <Color x:Key="SystemAccentColor">#FFF31260</Color>
            <Color x:Key="SystemAccentColorLight1">#FFF75F94</Color>
            <Color x:Key="SystemAccentColorLight2">#FFF98FB2</Color>
            <Color x:Key="SystemAccentColorLight3">#FFFBBFD0</Color>
            <Color x:Key="SystemAccentColorDark1">#FFD31256</Color>
            <Color x:Key="SystemAccentColorDark2">#FFB30F4A</Color>
            <Color x:Key="SystemAccentColorDark3">#FF930C3D</Color>

            <!--
                按钮悬浮 / 按下态：模板里用 {StaticResource} 直接取 Brush，
                不走"字符串→Brush"的隐式转换（那种在 ObjectAnimation 的 Value 里不稳）。
                主按钮（粉）与次按钮（近黑）各一对。
            -->
            <SolidColorBrush x:Key="JpAccentButtonHoverBrush" Color="#FFF75F94" />
            <SolidColorBrush x:Key="JpAccentButtonPressedBrush" Color="#FFD31256" />
            <SolidColorBrush x:Key="JpButtonHoverBrush" Color="#FF2A2A30" />
            <SolidColorBrush x:Key="JpButtonPressedBrush" Color="#FF15151A" />

            <!-- 卡片：大圆角 + 粉描边（日系的关键是圆角与留白） -->
            <Style x:Key="CardStyle" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource JpCardBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource JpCardStrokeBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="16" />
                <Setter Property="Padding" Value="20" />
            </Style>

            <Style x:Key="PageTitleStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="26" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="CharacterSpacing" Value="20" />
                <Setter Property="Foreground" Value="{ThemeResource JpTextBrush}" />
                <Setter Property="Margin" Value="0,0,0,2" />
            </Style>

            <Style x:Key="SectionHeaderStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="13" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="CharacterSpacing" Value="30" />
                <Setter Property="Foreground" Value="{ThemeResource JpSubtleTextBrush}" />
                <Setter Property="Margin" Value="0,0,0,8" />
            </Style>

            <Style x:Key="CaptionStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="12" />
                <Setter Property="Foreground" Value="{ThemeResource JpSubtleTextBrush}" />
            </Style>

            <Style x:Key="BodyStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="13" />
                <Setter Property="LineHeight" Value="22" />
                <Setter Property="Foreground" Value="{ThemeResource JpTextBrush}" />
            </Style>

            <!--
                主按钮：粉填充（NapCat #F31260）+ **自带模板**。
                为什么必须自己写模板：AccentButtonStyle 的模板在 Normal/PointerOver/Pressed 里
                直接取 {ThemeResource AccentButtonBackground*}，而那是个 StaticResource 别名 →
                只在 Style 里改 Background、或覆盖 AccentButton* 资源，按钮都仍是系统强调色（青蓝）。
                所以这里不再 BasedOn，颜色全部写在模板里。
            -->
            <Style x:Key="JpAccentButtonStyle" TargetType="Button">
                <Setter Property="Foreground" Value="White" />
                <Setter Property="Background" Value="#FFF31260" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="CornerRadius" Value="10" />
                <Setter Property="Padding" Value="16,7" />
                <Setter Property="FontSize" Value="14" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="MinHeight" Value="32" />
                <Setter Property="HorizontalContentAlignment" Value="Center" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Grid x:Name="Root"
                                  Background="{TemplateBinding Background}"
                                  CornerRadius="{TemplateBinding CornerRadius}">
                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup x:Name="CommonStates">
                                        <VisualState x:Name="Normal" />
                                        <VisualState x:Name="PointerOver">
                                            <Storyboard>
                                                <ObjectAnimationUsingKeyFrames Storyboard.TargetName="Root"
                                                                               Storyboard.TargetProperty="Background">
                                                    <DiscreteObjectKeyFrame KeyTime="0"
                                                                            Value="{StaticResource JpAccentButtonHoverBrush}" />
                                                </ObjectAnimationUsingKeyFrames>
                                            </Storyboard>
                                        </VisualState>
                                        <VisualState x:Name="Pressed">
                                            <Storyboard>
                                                <ObjectAnimationUsingKeyFrames Storyboard.TargetName="Root"
                                                                               Storyboard.TargetProperty="Background">
                                                    <DiscreteObjectKeyFrame KeyTime="0"
                                                                            Value="{StaticResource JpAccentButtonPressedBrush}" />
                                                </ObjectAnimationUsingKeyFrames>
                                            </Storyboard>
                                        </VisualState>
                                        <VisualState x:Name="Disabled">
                                            <Storyboard>
                                                <!-- Opacity 是 double，必须用 Double 关键帧；
                                                     用 ObjectAnimation 塞字符串 "0.5" 会在运行时类型不匹配 -->
                                                <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Root"
                                                                               Storyboard.TargetProperty="Opacity">
                                                    <DiscreteDoubleKeyFrame KeyTime="0" Value="0.5" />
                                                </DoubleAnimationUsingKeyFrames>
                                            </Storyboard>
                                        </VisualState>
                                    </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>
                                <ContentPresenter x:Name="ContentPresenter"
                                                  Content="{TemplateBinding Content}"
                                                  ContentTemplate="{TemplateBinding ContentTemplate}"
                                                  Padding="{TemplateBinding Padding}"
                                                  Foreground="{TemplateBinding Foreground}"
                                                  FontWeight="{TemplateBinding FontWeight}"
                                                  FontSize="{TemplateBinding FontSize}"
                                                  HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                  VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                                                  AutomationProperties.AccessibilityView="Raw" />
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!--
                次按钮：近黑底 + 粉字（NapCat 次按钮，让位给主按钮不抢眼）。
                ⚠️ 必须**也写显式模板**：不写模板时会落到系统 Button 默认模板，
                圆角取 ControlCornerRadius（4），于是关闭/取消按钮是 4、保存按钮是 10 ——
                用户反馈的"两个按钮圆角不一样"就是这个。模板结构与主按钮逐行一致，只有颜色不同。
            -->
            <Style x:Key="JpButtonStyle" TargetType="Button">
                <Setter Property="Foreground" Value="#FFF31260" />
                <Setter Property="Background" Value="#FF1F1F23" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="CornerRadius" Value="10" />
                <Setter Property="Padding" Value="16,7" />
                <Setter Property="FontSize" Value="14" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="MinHeight" Value="32" />
                <Setter Property="HorizontalContentAlignment" Value="Center" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Grid x:Name="Root"
                                  Background="{TemplateBinding Background}"
                                  CornerRadius="{TemplateBinding CornerRadius}">
                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup x:Name="CommonStates">
                                        <VisualState x:Name="Normal" />
                                        <VisualState x:Name="PointerOver">
                                            <Storyboard>
                                                <ObjectAnimationUsingKeyFrames Storyboard.TargetName="Root"
                                                                               Storyboard.TargetProperty="Background">
                                                    <DiscreteObjectKeyFrame KeyTime="0"
                                                                            Value="{StaticResource JpButtonHoverBrush}" />
                                                </ObjectAnimationUsingKeyFrames>
                                            </Storyboard>
                                        </VisualState>
                                        <VisualState x:Name="Pressed">
                                            <Storyboard>
                                                <ObjectAnimationUsingKeyFrames Storyboard.TargetName="Root"
                                                                               Storyboard.TargetProperty="Background">
                                                    <DiscreteObjectKeyFrame KeyTime="0"
                                                                            Value="{StaticResource JpButtonPressedBrush}" />
                                                </ObjectAnimationUsingKeyFrames>
                                            </Storyboard>
                                        </VisualState>
                                        <VisualState x:Name="Disabled">
                                            <Storyboard>
                                                <!-- Opacity 是 double，必须用 Double 关键帧（与主按钮一致） -->
                                                <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Root"
                                                                               Storyboard.TargetProperty="Opacity">
                                                    <DiscreteDoubleKeyFrame KeyTime="0" Value="0.5" />
                                                </DoubleAnimationUsingKeyFrames>
                                            </Storyboard>
                                        </VisualState>
                                    </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>
                                <ContentPresenter x:Name="ContentPresenter"
                                                  Content="{TemplateBinding Content}"
                                                  ContentTemplate="{TemplateBinding ContentTemplate}"
                                                  Padding="{TemplateBinding Padding}"
                                                  Foreground="{TemplateBinding Foreground}"
                                                  FontWeight="{TemplateBinding FontWeight}"
                                                  FontSize="{TemplateBinding FontSize}"
                                                  HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                  VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                                                  AutomationProperties.AccessibilityView="Raw" />
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- 进度条：粉色（默认是系统蓝，和主题不搭） -->
            <Style x:Key="JpProgressBarStyle" TargetType="ProgressBar">
                <Setter Property="Foreground" Value="{ThemeResource JpAccentBrush}" />
                <Setter Property="Background" Value="{ThemeResource JpAccentSoftBrush}" />
                <Setter Property="Height" Value="8" />
                <Setter Property="CornerRadius" Value="4" />
            </Style>

            <!--
                对话框：跟主窗体同一套日系配色（紫底 + 樱粉描边 + 文字色）。
                定义在**顶层**而不是 ThemeDictionaries 里 —— 代码里 Application.Current.Resources[key]
                取不到 ThemeDictionaries 里的资源（实测），放这里才能被 C# 直接套上。
                BasedOn 必须带上：默认样式里有 Template，不继承就没模板、弹出来是空白。
                背景用 **JpDialogSurfaceBrush（不透明）**，不是 JpCardBrush（卡片半透明是设计，弹窗不行）。
                三个按钮样式都在这儿定死：主=粉填充 / 次=柔粉 / 关闭=柔粉，CornerRadius 统一 10。
            -->
            <Style x:Key="JpDialogStyle" TargetType="ContentDialog"
                   BasedOn="{StaticResource DefaultContentDialogStyle}">
                <Setter Property="Background" Value="{ThemeResource JpDialogSurfaceBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource JpCardStrokeBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="12" />
                <Setter Property="Foreground" Value="{ThemeResource JpTextBrush}" />
                <Setter Property="PrimaryButtonStyle" Value="{StaticResource JpAccentButtonStyle}" />
                <Setter Property="SecondaryButtonStyle" Value="{StaticResource JpButtonStyle}" />
                <Setter Property="CloseButtonStyle" Value="{StaticResource JpButtonStyle}" />
            </Style>

            <Style x:Key="ToolbarIconButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Padding" Value="8" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="MinWidth" Value="32" />
                <Setter Property="Height" Value="32" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
