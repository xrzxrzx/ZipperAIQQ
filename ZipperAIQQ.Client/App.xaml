<Application
    x:Class="ZipperAIQQ.Client.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>

            <!-- ═══════════════════════════════════════════════
                 日系 · 粉嫩主题（参考 NapCat WebUI 的浅色卡片 + 粉色强调）
                 暗色：夜樱粉紫  ·  浅色：樱白粉
                 ═══════════════════════════════════════════════ -->
            <ResourceDictionary.ThemeDictionaries>

                <ResourceDictionary x:Key="Light">
                    <!-- 背景：更粉的樱白渐变 -->
                    <LinearGradientBrush x:Key="JpBackgroundBrush" StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#FFF5FA" Offset="0" />
                        <GradientStop Color="#FDEFFA" Offset="0.5" />
                        <GradientStop Color="#FFF0F6" Offset="1" />
                    </LinearGradientBrush>

                    <SolidColorBrush x:Key="JpCardBrush" Color="#EEFFFFFF" />
                    <SolidColorBrush x:Key="JpCardHoverBrush" Color="#FFFFFFFF" />
                    <SolidColorBrush x:Key="JpCardStrokeBrush" Color="#33FF7FB0" />

                    <!-- 强调：樱粉 -->
                    <SolidColorBrush x:Key="JpAccentBrush" Color="#FF7FB0" />
                    <SolidColorBrush x:Key="JpAccentSoftBrush" Color="#33FF7FB0" />
                    <SolidColorBrush x:Key="JpAccentSecondaryBrush" Color="#C9A0DC" />

                    <SolidColorBrush x:Key="JpTextBrush" Color="#4A3A44" />
                    <SolidColorBrush x:Key="JpSubtleTextBrush" Color="#9A8490" />

                    <SolidColorBrush x:Key="JpChromeBrush" Color="#40FFFFFF" />
                    <SolidColorBrush x:Key="JpSelectionBrush" Color="#2EFF7FB0" />
                </ResourceDictionary>

                <ResourceDictionary x:Key="Dark">
                    <!-- 背景：夜樱粉紫（不是纯灰紫，带粉调） -->
                    <LinearGradientBrush x:Key="JpBackgroundBrush" StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#2A1622" Offset="0" />
                        <GradientStop Color="#331A2E" Offset="0.5" />
                        <GradientStop Color="#241322" Offset="1" />
                    </LinearGradientBrush>

                    <SolidColorBrush x:Key="JpCardBrush" Color="#CC3A2434" />
                    <SolidColorBrush x:Key="JpCardHoverBrush" Color="#DD452B3E" />
                    <SolidColorBrush x:Key="JpCardStrokeBrush" Color="#40FF9EC4" />

                    <!-- 强调：亮樱粉（暗底上更醒目） -->
                    <SolidColorBrush x:Key="JpAccentBrush" Color="#FF8FBE" />
                    <SolidColorBrush x:Key="JpAccentSoftBrush" Color="#33FF8FBE" />
                    <SolidColorBrush x:Key="JpAccentSecondaryBrush" Color="#C9A0DC" />

                    <!-- 文字：粉白（原 #EDE9F2 偏灰，粉嫩化后偏粉） -->
                    <SolidColorBrush x:Key="JpTextBrush" Color="#F8EAEF" />
                    <SolidColorBrush x:Key="JpSubtleTextBrush" Color="#C4A6B8" />

                    <SolidColorBrush x:Key="JpChromeBrush" Color="#33FFFFFF" />
                    <SolidColorBrush x:Key="JpSelectionBrush" Color="#2EFF8FBE" />
                </ResourceDictionary>

            </ResourceDictionary.ThemeDictionaries>

            <!-- 卡片：大圆角 + 粉描边（日系的关键是圆角与留白） -->
            <Style x:Key="CardStyle" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource JpCardBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource JpCardStrokeBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="16" />
                <Setter Property="Padding" Value="20" />
            </Style>

            <Style x:Key="PageTitleStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="26" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="CharacterSpacing" Value="20" />
                <Setter Property="Foreground" Value="{ThemeResource JpTextBrush}" />
                <Setter Property="Margin" Value="0,0,0,2" />
            </Style>

            <Style x:Key="SectionHeaderStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="13" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="CharacterSpacing" Value="30" />
                <Setter Property="Foreground" Value="{ThemeResource JpSubtleTextBrush}" />
                <Setter Property="Margin" Value="0,0,0,8" />
            </Style>

            <Style x:Key="CaptionStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="12" />
                <Setter Property="Foreground" Value="{ThemeResource JpSubtleTextBrush}" />
            </Style>

            <Style x:Key="BodyStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="13" />
                <Setter Property="LineHeight" Value="22" />
                <Setter Property="Foreground" Value="{ThemeResource JpTextBrush}" />
            </Style>

            <!-- 主按钮：亮粉填充 -->
            <Style x:Key="JpAccentButtonStyle" TargetType="Button" BasedOn="{StaticResource AccentButtonStyle}">
                <Setter Property="CornerRadius" Value="10" />
                <Setter Property="Padding" Value="16,7" />
                <Setter Property="Background" Value="{ThemeResource JpAccentBrush}" />
                <Setter Property="Foreground" Value="White" />
                <Setter Property="BorderThickness" Value="0" />
            </Style>

            <!-- 次按钮：柔粉底 -->
            <Style x:Key="JpButtonStyle" TargetType="Button">
                <Setter Property="CornerRadius" Value="10" />
                <Setter Property="Padding" Value="16,7" />
                <Setter Property="Background" Value="{ThemeResource JpAccentSoftBrush}" />
                <Setter Property="Foreground" Value="{ThemeResource JpTextBrush}" />
                <Setter Property="BorderThickness" Value="0" />
            </Style>

            <!-- 进度条：粉色（默认是系统蓝，和主题不搭） -->
            <Style x:Key="JpProgressBarStyle" TargetType="ProgressBar">
                <Setter Property="Foreground" Value="{ThemeResource JpAccentBrush}" />
                <Setter Property="Background" Value="{ThemeResource JpAccentSoftBrush}" />
                <Setter Property="Height" Value="8" />
                <Setter Property="CornerRadius" Value="4" />
            </Style>

            <!--
                对话框：跟主窗体同一套日系配色（卡片紫底 + 樱粉描边 + 文字色）。
                定义在**顶层**而不是 ThemeDictionaries 里 —— 代码里 Application.Current.Resources[key]
                取不到 ThemeDictionaries 里的资源（实测），放这里才能被 C# 直接套上。
                BasedOn 必须带上：默认样式里有 Template，不继承就没模板、弹出来是空白。
            -->
            <Style x:Key="JpDialogStyle" TargetType="ContentDialog"
                   BasedOn="{StaticResource DefaultContentDialogStyle}">
                <Setter Property="Background" Value="{ThemeResource JpCardBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource JpCardStrokeBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="12" />
                <Setter Property="Foreground" Value="{ThemeResource JpTextBrush}" />
                <Setter Property="PrimaryButtonStyle" Value="{StaticResource JpAccentButtonStyle}" />
                <Setter Property="CloseButtonStyle" Value="{StaticResource JpButtonStyle}" />
            </Style>

            <Style x:Key="ToolbarIconButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Padding" Value="8" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="MinWidth" Value="32" />
                <Setter Property="Height" Value="32" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
