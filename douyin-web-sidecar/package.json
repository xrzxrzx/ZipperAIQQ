{
  "name": "zipperaiqq-douyin-web-sidecar",
  "version": "0.1.0",
  "private": true,
  "description": "ZipperAIQQ 抖音 Web sidecar：Playwright 驱动 Chromium 登录抖音网页版，收发私信并把帧推给 /ws/channel",
  "type": "module",
  "engines": {
    "node": ">=22.5.0"
  },
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "dev": "tsx src/main.ts",
    "typecheck": "tsc -p tsconfig.test.json",
    "test": "node --test --experimental-strip-types test/*.test.ts"
  },
  "dependencies": {
    "playwright": "1.56.1",
    "protobufjs": "7.4.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
